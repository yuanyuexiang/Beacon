# 复制为 apps/api/.env 后按需修改。所有变量以 BEACON_ 为前缀。
BEACON_DATABASE_URL=postgresql+psycopg://beacon:beacon@localhost:5433/beacon
BEACON_TEST_DATABASE_URL=postgresql+psycopg://beacon:beacon@localhost:5433/beacon_test
# 受控文件目录（菜单证据、样稿），不在仓库内；必须为绝对路径
BEACON_DATA_DIR=/absolute/path/to/beacon-data
# 会话签名密钥（D2），至少 32 字符随机串
BEACON_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
# 首个操作者（D2 引导创建）
BEACON_BOOTSTRAP_OPERATOR=admin
BEACON_BOOTSTRAP_PASSWORD=change-me

# 抓取时按解析出的 IP 阻断内网目标（默认 true）。若本机解析器把所有域名映射到代理地址（如 198.18.x.x），设为 false；字面量内网地址仍阻断
BEACON_FETCH_IP_CHECK=true

# 模型 provider：fake（默认，不调用真实模型）| deepseek（已真实评测，见 plan/model-eval-v1.md）| anthropic（未真实验证）
BEACON_LLM_PROVIDER=fake
# 为空时按 provider 取默认：deepseek→deepseek-flash（支持图片），anthropic→claude-opus-5-5
# BEACON_LLM_MODEL=
# 转录任务默认关闭思考（DeepSeek 生效）
BEACON_LLM_THINKING=false
BEACON_LLM_EFFORT=medium
# 密钥只放在 .env（已 gitignore），不要写进任何提交文件
# BEACON_DEEPSEEK_API_KEY=
# BEACON_ANTHROPIC_API_KEY=

# Companies House 主体候选检索（可选）：developer.company-information.service.gov.uk 的 live 应用下创建 REST API key。
# 未配置时 `GET /api/leads/{id}/entity-candidates` 返回 503，其余功能不受影响。只给候选，主体由人工确认
# BEACON_COMPANIES_HOUSE_API_KEY=

# 官网候选搜索：可选 Exa API key；留空使用免费限流 MCP。密钥通过请求头发送，不放入 URL
# BEACON_EXA_API_KEY=

# Google Places：只做单家实时查看，不保存响应或照片，不进入模型与菜单归档。
# BEACON_GOOGLE_PLACES_API_KEY=
# 显式代理可选，空值直连且忽略进程代理变量；本机 Clash 例：socks5h://127.0.0.1:7890
# BEACON_GOOGLE_PLACES_PROXY=
BEACON_GOOGLE_PLACES_DAILY_LIMIT=200

# Maps 菜单浏览器执行器（测试阶段）；运行 python3 scripts/configure_maps_worker.py 自动生成密钥。
# BEACON_MAPS_WORKER_TOKEN=填写与执行器 token 文件一致的至少 32 字符随机值

# 独立 Gmail HTTP 服务与 Bearer 密钥文件（密钥内容不放前端）
BEACON_GMAIL_SERVICE_URL=http://gmail-service:8090
BEACON_GMAIL_SERVICE_TOKEN_FILE=/run/secrets/gmail_service_token
