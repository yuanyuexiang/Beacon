# 复制为 apps/api/.env 后按需修改。所有变量以 BEACON_ 为前缀。
BEACON_DATABASE_URL=postgresql+psycopg://beacon:beacon@localhost:5433/beacon
BEACON_TEST_DATABASE_URL=postgresql+psycopg://beacon:beacon@localhost:5433/beacon_test
# 受控文件目录（菜单证据、样稿），不在仓库内；必须为绝对路径
BEACON_DATA_DIR=/absolute/path/to/beacon-data
# 会话签名密钥（D2），至少 32 字符随机串
BEACON_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
# 首个操作者（D2 引导创建）
BEACON_BOOTSTRAP_OPERATOR=admin
BEACON_BOOTSTRAP_PASSWORD=change-me

# 抓取时按解析出的 IP 阻断内网目标（默认 true）。若本机解析器把所有域名映射到代理地址（如 198.18.x.x），设为 false；字面量内网地址仍阻断
BEACON_FETCH_IP_CHECK=true
