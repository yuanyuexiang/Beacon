# 服务器 /opt/beacon/config/runtime.env，由首次配置生成；真实值不提交。
BEACON_DOMAIN=beacon.ai-onestep.com
POSTGRES_PASSWORD=generate-random-password
BEACON_DATABASE_URL=postgresql+psycopg://beacon:generate-random-password@postgres:5432/beacon
BEACON_SECRET_KEY=generate-at-least-32-random-characters
BEACON_BOOTSTRAP_OPERATOR=admin
BEACON_BOOTSTRAP_PASSWORD=generate-strong-password
BEACON_LLM_PROVIDER=fake
# 可选现有集成：后端使用，不能在 build args 中传递
BEACON_DEEPSEEK_API_KEY=
BEACON_GOOGLE_PLACES_API_KEY=
BEACON_COMPANIES_HOUSE_API_KEY=
BEACON_EXA_API_KEY=
