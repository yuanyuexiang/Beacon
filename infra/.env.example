# 复制为 infra/.env。compose 会把这些变量注入 api 容器；密钥不要提交。
BEACON_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
BEACON_BOOTSTRAP_OPERATOR=admin
BEACON_BOOTSTRAP_PASSWORD=change-me-please
# 抓取时按解析 IP 阻断内网（默认 true；解析器把域名映射到代理地址的环境设为 false）
BEACON_FETCH_IP_CHECK=true
# 模型：fake | deepseek | anthropic
BEACON_LLM_PROVIDER=fake
BEACON_DEEPSEEK_API_KEY=
BEACON_ANTHROPIC_API_KEY=
# Companies House 主体候选检索（可选；须为 live 应用下的 REST API key，Test 应用的 key 会被正式接口以 401 拒绝）。只给候选，主体由人工确认
BEACON_COMPANIES_HOUSE_API_KEY=

# 官网候选搜索：可选 Exa API key；留空使用免费限流 MCP。密钥通过请求头发送，不放入 URL
# BEACON_EXA_API_KEY=

# Google Places 单家实时查看（可选）。宿主机 Clash 示例：socks5h://host.docker.internal:7890
# 容器的 127.0.0.1 不是宿主机；部署服务器按实际网络出口配置。
# BEACON_GOOGLE_PLACES_API_KEY=
# BEACON_GOOGLE_PLACES_PROXY=
BEACON_GOOGLE_PLACES_DAILY_LIMIT=200

# Maps 菜单浏览器执行器（测试阶段）；运行 python3 scripts/configure_maps_worker.py 自动生成密钥。
# BEACON_MAPS_WORKER_TOKEN=填写与执行器 token 文件一致的至少 32 字符随机值

# Gmail 服务 OAuth 回调和可选 HTTP 代理（服务器按实际域名设置）
BEACON_GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
BEACON_GMAIL_PROXY=
